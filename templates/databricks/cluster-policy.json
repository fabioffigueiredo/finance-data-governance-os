{
    "spark_version": {
        "type": "fixed",
        "value": "13.3.x-scala2.12",
        "hidden": false
    },
    "node_type_id": {
        "type": "allowed",
        "values": [
            "Standard_DS3_v2",
            "Standard_DS4_v2"
        ],
        "defaultValue": "Standard_DS3_v2"
    },
    "autotermination_minutes": {
        "type": "fixed",
        "value": 60
    },
    "aws_attributes.instance_profile_arn": {
        "type": "forbidden"
    },
    "spark_conf.spark.databricks.io.cache.enabled": {
        "type": "fixed",
        "value": "true"
    },
    "custom_tags.owner": {
        "type": "required"
    }
}